DATABASE_URL="postgresql://affiliate_marketplace:affiliate_marketplace@localhost:5433/affiliate_marketplace?schema=public"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Set true when serving from an IP/domain or behind proxy.
AUTH_TRUST_HOST="true"

# Google OAuth client (Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email OTP — SMTP credentials. For local dev, run `docker compose
# up -d` and point these at Mailpit (host: localhost, port: 1025,
# no auth) — inbox UI at http://localhost:8025.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Binoregn <no-reply@example.com>"

# Public site address used for links in creator emails (falls back to
# AUTH_URL). Set it to your real domain in production, e.g.
# https://binoregn.com — otherwise email buttons point at localhost.
APP_URL=""

# Product images upload locally to public/uploads/ — no third-party
# storage service to configure.

# Seeded admin account — whoever signs in with this email becomes
# ADMIN after running `npx prisma db seed`.
ADMIN_SEED_EMAIL=""

# Telegram bot (admin alerts only — creators are notified by email). Create a bot with
# @BotFather, paste its token and username here, set a random webhook
# secret, then once the site is live on HTTPS run:
#   npm run telegram:webhook -- https://your-domain.com
# Each admin connects from Settings → Connect Telegram.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Secret for the Friday payout reminder cron
# (GET /api/cron/payout-reminder with "Authorization: Bearer <secret>").
CRON_SECRET=""

# Contact details shown on buyer pages and creator status pages.
NEXT_PUBLIC_CONTACT_EMAIL="hello@binoregn.com"
NEXT_PUBLIC_CONTACT_PHONE=""

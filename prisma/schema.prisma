
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  ADMIN
}


enum PayoutMethod {
  BANK_TRANSFER
  TELEBIRR
  CBE_BIRR
}

enum CreatorPlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  TELEGRAM
  OTHER
}

enum CreatorCategory {
  TECH
  FASHION
  BEAUTY
  LIFESTYLE
  FOOD
  GAMING
  EDUCATION
  COMEDY
  OTHER
}

enum CreatorProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutOptionCategory {
  BANK
  WALLET
}

model PayoutOption {
  id        String               @id @default(cuid())
  category  PayoutOptionCategory
  name      String
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([category, name])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CREATOR)
  createdAt     DateTime  @default(now())
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  payoutMethod        PayoutMethod?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutBankName      String?

  creatorUsername              String?               @unique
  creatorPhone                 String?
  creatorDisplayName           String?
  creatorPlatform              CreatorPlatform?
  creatorProfileUrl            String?
  creatorCategory              CreatorCategory?
  creatorProfileStatus         CreatorProfileStatus?
  creatorOnboardingCompletedAt DateTime?

  // Telegram (lib/telegram.ts). telegramLinkToken is a one-time random
  // token in the bot deep link; the webhook swaps it for the chat id.
  telegramChatId    String? @unique
  telegramLinkToken String? @unique

  accounts Account[]
  sessions Session[]

  applications    Application[]
  affiliateLinks  AffiliateLink[]
  ordersAsCreator Order[]         @relation("OrderCreator")
  commissions     Commission[]
  payouts         Payout[]
  notifications   Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  category       String?
  subCategory    String?
  features       String[] @default([])
  care           String[] @default([])
  shipping       String[] @default([])
  returns        String[] @default([])
  colors         String[] @default([])
  sizes          String[] @default([])
  // Whole Birr amounts — no online payment gateway means no
  // currency-conversion or minor-unit (cents) handling is needed.
  priceBirr      Int
  compareAtBirr  Int?
  // Creator discount code (lib/discount.ts): a fixed Birr amount off the
  // order when the buyer types discountCode at checkout. Only active while
  // discountEnabled is on. The code is never shown on the buyer's product
  // page — creators share it. Commission stays the full commissionBirr.
  discountEnabled Boolean @default(false)
  discountBirr    Int?
  discountCode    String?
  rating         Float?
  ratingCount    Int?     @default(0)
  soldCount      Int?     @default(0)
  sellerName     String?
  sellerVerified Boolean  @default(false)
  sellerRating   Float?
  sellerSoldCount Int?    @default(0)
  shippingDiscountLabel String?
  shippingPackageLabel  String?
  shippingDeliveryTime  String?
  shippingArrives       String?
  commissionBirr Int
  imageUrls      String[]
  
  stock          Int      @default(100)
  // Max creators who may promote this product (approved = one spot
  // each; pending requests don't hold a spot). null = unlimited.
  // Enforced in lib/promotion.ts callers (apply + admin approve).
  maxCreators    Int?
  // Four badges under Buy Now on the product page (lib/product-badges.ts
  // holds the same defaults). Empty entries are hidden.
  trustBadges    String[] @default(["Free Delivery", "Delivered within 2 hours", "Same day return", "Nothing to pay before delivery"])

  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]
  affiliateLinks AffiliateLink[]
  orders         Order[]
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Application {
  id        String            @id @default(cuid())
  creatorId String
  creator   User              @relation(fields: [creatorId], references: [id])
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?
  deletedAt DateTime?

  affiliateLink AffiliateLink?
  @@unique([creatorId, productId])
}

model AffiliateLink {
  id            String      @id @default(cuid())
  // Short public code — the link URL is /r/[slug]. No default: always
  // set explicitly from lib/affiliate-link-code.ts.
  slug          String      @unique
  creatorId     String
  creator       User        @relation(fields: [creatorId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  createdAt     DateTime    @default(now())
  
  viewCount     Int         @default(0)

  orders Order[]
  visits LinkVisit[]

  @@unique([creatorId, productId])
}

// One row per (link, visitor). viewCount on AffiliateLink only goes up
// when this visitor's last counted view is 24h+ old (or there is none),
// so the same person opening a link repeatedly counts once a day.
// visitorId is a random id kept in the buyer's "bv" cookie
// (app/api/public/links/[slug]/view/route.ts).
model LinkVisit {
  id            String        @id @default(cuid())
  linkId        String
  link          AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  visitorId     String
  lastCountedAt DateTime      @default(now())

  @@unique([linkId, visitorId])
  @@index([lastCountedAt])
}

enum OrderDeliveryStatus {
  PLACED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderFulfillmentStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
}

model Order {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id])
  creatorId       String
  creator         User          @relation("OrderCreator", fields: [creatorId], references: [id])

  buyerName    String
  buyerPhone   String
  buyerAddress String
  buyerCity    String?
  buyerEmail   String?
  buyerNotes   String?
  quantity     Int           @default(1)
  color        String?
  size         String?
  // Discount actually given on this order (fixed Birr, once per order) and
  // the code used — snapshotted at checkout so later product changes never
  // alter it. Total = product.priceBirr × quantity − discountBirr.
  discountBirr Int           @default(0)
  discountCode String?

  deliveryStatus   OrderDeliveryStatus @default(PLACED)
  fulfillmentStatus OrderFulfillmentStatus @default(PLACED)

  cashReconciledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  commission Commission?
}

enum CommissionStatus {
  PENDING
  PAID
}

// createdAt = when the commission became PENDING (the order was marked
// Delivered). That timestamp decides which Friday payout covers it
// (lib/commission/payouts.ts).
model Commission {
  id         String           @id @default(cuid())
  orderId    String           @unique
  order      Order            @relation(fields: [orderId], references: [id])
  creatorId  String
  creator    User             @relation(fields: [creatorId], references: [id])
  amountBirr Int
  status     CommissionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  paidAt     DateTime?
  // Set when a Friday payout pays this commission (status → PAID).
  payoutId   String?
  payout     Payout?          @relation(fields: [payoutId], references: [id])

  deletedAt  DateTime?

  @@index([status, createdAt])
}

// One creator's share of a Friday payout (replaces creator withdrawal
// requests, 2026-11-11). Created only when admin marks it paid; the
// "due" list before that is computed live from PENDING commissions.
// Payout details are snapshotted so later profile edits don't rewrite
// where a past payout was sent.
model Payout {
  id                  String        @id @default(cuid())
  creatorId           String
  creator             User          @relation(fields: [creatorId], references: [id])
  amountBirr          Int
  // The Thursday 11:59 PM (Addis Ababa) cutoff this payout covers.
  cutoffAt            DateTime
  paidAt              DateTime      @default(now())
  payoutMethod        PayoutMethod?
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutBankName      String?

  commissions Commission[]

  @@index([creatorId])
}

// Creator notifications (progress-tracker 2026-11-11): saved here for
// the dashboard bell and also sent on Telegram when the creator has
// connected it (lib/notifications.ts). One row per creator per event.
enum NotificationType {
  PROFILE_APPROVED
  PROFILE_REJECTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  // Covers both "order delivered" and "commission added" — they happen
  // at the same moment, so creators get one message, not two.
  ORDER_DELIVERED
  COMMISSION_PAID
  ANNOUNCEMENT
  // A promoted product went out of stock/unpublished (links show "not
  // found"), or came back (lib/notifications.ts notifyProductAvailability).
  PRODUCT_PAUSED
  PRODUCT_RESUMED
}

model Notification {
  id             String           @id @default(cuid())
  creatorId      String
  creator        User             @relation(fields: [creatorId], references: [id])
  type           NotificationType
  title          String
  body           String
  href           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  announcementId String?
  announcement   Announcement?    @relation(fields: [announcementId], references: [id])

  @@index([creatorId, createdAt])
}

// An admin message to all approved creators; fanned out into one
// Notification per creator when sent.
model Announcement {
  id            String         @id @default(cuid())
  title         String
  body          String
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

// Site-wide settings admins edit in Settings — a single row (id "site",
// read/created by lib/site-settings.ts).
// orderPhone + showOrderPhone: the "Call us" number with a Call now button
// on the buyer's order confirmation (between order number and tracking
// link). Hidden when showOrderPhone is false or no number is set.
model SiteSetting {
  id             String   @id @default("site")
  orderPhone     String?
  showOrderPhone Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}
